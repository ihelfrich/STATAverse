    {
      "id": "direct-loop-stop",
      "source": "generate double first=0\ngenerate double skipped=0\ncap forvalues j=1/3 {\nreplace first=first+1\nerror 459\nreplace skipped=skipped+1\n}\ngenerate double marker=_rc",
      "columns": [
        { "name": "hours", "values": [1, 2, 3, 4] },
        { "name": "attendance", "values": [60, 70, 80, 90] },
        { "name": "score", "values": [20, 31, 35, 49] },
        { "name": "first", "values": [1, 1, 1, 1] },
        { "name": "skipped", "values": [0, 0, 0, 0] },
        { "name": "marker", "values": [0, 0, 0, 0] }
      ],
      "returnCode": 0,
      "visible": []
    },
    {
