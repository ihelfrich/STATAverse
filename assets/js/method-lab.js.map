{
  "groups": [
    {
      "id": "outcome",
      "title": "Outcome",
      "subtitle": "What quantity is recorded for each observation?",
      "options": [
        {
          "id": "continuous",
          "label": "Continuous outcome",
          "hint": "An amount, score or measurement.",
          "methods": [
            "ols"
          ]
        },
        {
          "id": "binary",
          "label": "Binary outcome (0 or 1)",
          "hint": "An event indicator. Compare probability-point and nonlinear probability models.",
          "methods": [
            "lpm",
            "logit"
          ]
        },
        {
          "id": "count",
          "label": "Nonnegative count",
          "hint": "Events counted over a defined exposure period.",
          "methods": [
            "count"
          ]
        },
        {
          "id": "fraction",
          "label": "Fraction or share (0 to 1)",
          "hint": "A proportion with a stated denominator; boundaries may occur.",
          "methods": [
            "fractional"
          ]
        },
        {
          "id": "duration",
          "label": "Time to an event",
          "hint": "Event times with a defined risk period and possible censoring.",
          "methods": [
            "hazard"
          ]
        }
      ]
    },
    {
      "id": "structure",
      "title": "Observation structure",
      "subtitle": "Does the same unit appear at multiple times?",
      "options": [
        {
          "id": "cross",
          "label": "One record per unit",
          "hint": "A cross-section, or distinct units in repeated cross-sections.",
          "methods": []
        },
        {
          "id": "panel",
          "label": "Repeated records per unit",
          "hint": "Establish identifiers, time ordering and within-unit variation.",
          "methods": []
        }
      ]
    },
    {
      "id": "design",
      "title": "Purpose and proposed design",
      "subtitle": "What would justify the interpretation you want?",
      "options": [
        {
          "id": "association",
          "label": "Association or prediction",
          "hint": "Specify the target population and sample; a useful association need not be causal.",
          "methods": []
        },
        {
          "id": "unresolved",
          "label": "Causal design unresolved",
          "hint": "Identify the confounding or selection mechanism before choosing a remedy.",
          "methods": []
        },
        {
          "id": "randomized",
          "label": "Randomized assignment",
          "hint": "Check assignment, compliance, attrition and interference. Assignment effects and receipt effects differ.",
          "methods": []
        },
        {
          "id": "iv",
          "label": "Proposed excluded instrument",
          "hint": "Assess relevance, exclusion and exogeneity for the proposed instrument.",
          "methods": [
            "iv"
          ]
        },
        {
          "id": "did",
          "label": "Before/after treatment comparison",
          "hint": "Assess untreated trends, timing, anticipation and spillovers.",
          "methods": [
            "did"
          ]
        }
      ]
    },
    {
      "id": "dependence",
      "title": "Sampling and dependence",
      "subtitle": "Which observations may share unobserved shocks?",
      "options": [
        {
          "id": "independent",
          "label": "Independent observations",
          "hint": "Robust covariance allows unequal conditional variances; it does not repair confounding.",
          "methods": []
        },
        {
          "id": "clustered",
          "label": "Independent clusters",
          "hint": "Name a cluster variable justified by sampling or assignment, and assess the number of clusters.",
          "methods": []
        },
        {
          "id": "survey",
          "label": "Complex survey design",
          "hint": "Weights, strata and primary sampling units require estimator-specific survey support.",
          "methods": []
        },
        {
          "id": "unresolved",
          "label": "Not established yet",
          "hint": "Resolve the covariance structure before interpreting standard errors or p-values.",
          "methods": []
        }
      ]
    }
  ],
  "always": [
    "diagnostics",
    "reporting"
  ],
  "methods": {
    "ols": {
      "title": "Linear regression",
      "why": "A linear conditional-mean model or descriptive linear projection for a specified sample.",
      "stata": "regress y x1 x2, {vce}",
      "diagnostic": "Inspect functional form, influential observations and the covariance structure. Residual plots cannot establish exogeneity.",
      "pitfall": "Ignoring nonlinearity or omitted variables.",
      "links": [
        {
          "label": "Explore regression and adjustment",
          "href": "../Labs/"
        },
        {
          "label": "Read the OLS lesson",
          "href": "../ZeroToHero/modules/02-ols-intuition.html"
        }
      ],
      "category": "Outcome model",
      "scope": "A linear conditional mean or a descriptive linear projection, in the stated outcome units.",
      "assumptions": [
        "A causal slope needs a separate identification argument; a fitted regression does not supply one.",
        "Inspect functional form and the observations contributing to each estimate."
      ]
    },
    "logit": {
      "title": "Logit",
      "why": "Models binary outcomes with probabilities constrained to 0-1.",
      "stata": "logit y x1 x2, {vce}\nmargins, dydx(*)",
      "diagnostic": "Report marginal effects and predicted probabilities.",
      "pitfall": "Reading log-odds coefficients as probability-point changes, or treating fitted associations as causal.",
      "links": [
        {
          "label": "Limited outcomes module",
          "href": "../ZeroToHero/modules/03-limited-outcomes.html"
        },
        {
          "label": "Logit script",
          "href": "../ScriptLibrary/script.html?id=logit-margins"
        }
      ],
      "category": "Outcome model",
      "scope": "The log-odds index is linear; the fitted response probability is nonlinear and bounded.",
      "assumptions": [
        "Specify the conditional probability model and inspect separation and support.",
        "A logit coefficient is a log-odds change. Average marginal effects and probabilities answer different questions."
      ]
    },
    "count": {
      "title": "Poisson and negative binomial",
      "why": "Poisson models a nonnegative exponential conditional mean; negative binomial adds a particular dispersion structure.",
      "stata": "poisson y x1 x2, {vce}\n* A distinct dispersion specification for comparison:\nnbreg y x1 x2, {vce}",
      "diagnostic": "Study conditional dispersion, exposure and the process generating zeros. Poisson with robust inference does not require equal conditional mean and variance.",
      "pitfall": "Choosing NB from the unconditional variance alone, or treating many zeros as proof of a separate zero-generating process.",
      "links": [
        {
          "label": "Count model script",
          "href": "../ScriptLibrary/script.html?id=poisson-nb-overdispersion"
        }
      ],
      "category": "Outcome model",
      "scope": "Both model an exponential conditional mean; negative binomial adds a particular dispersion model.",
      "assumptions": [
        "Define exposure and the process that produces zeros.",
        "Poisson quasi-likelihood with a correctly specified mean and appropriate covariance does not require conditional mean–variance equality."
      ]
    },
    "fractional": {
      "title": "Fractional logit",
      "why": "Handles proportions between 0 and 1 without impossible predictions.",
      "stata": "fracreg logit y x1 x2, {vce}\nmargins, dydx(*)",
      "diagnostic": "Inspect fitted values for boundary issues.",
      "pitfall": "Ignoring boundary values, the denominator or the sampling structure; a linear model is not automatically invalid.",
      "links": [
        {
          "label": "Topics map",
          "href": "../Topics/"
        }
      ],
      "category": "Outcome model",
      "scope": "A conditional-mean model for responses in [0,1], including zero and one.",
      "assumptions": [
        "State the denominator and whether observations are aggregates of different sizes.",
        "A bounded nonlinear mean is a modeling choice; a linear projection is not automatically invalid."
      ]
    },
    "hazard": {
      "title": "Cox proportional-hazards model",
      "why": "Captures time-to-event outcomes and censoring.",
      "stata": "stset duration, failure(event)\nstcox x1 x2, {vce}",
      "diagnostic": "Check proportional hazards assumptions.",
      "pitfall": "Ignoring censoring or duration dependence.",
      "links": [
        {
          "label": "Topics map",
          "href": "../Topics/"
        }
      ],
      "category": "Outcome model",
      "scope": "A hazard model with a common multiplicative covariate effect; a hazard ratio is not a probability difference.",
      "assumptions": [
        "Define risk entry, event coding, censoring and time scale before fitting.",
        "Assess proportional hazards and whether censoring is plausibly independent conditional on the model."
      ]
    },
    "panel": {
      "title": "Linear unit and time fixed effects",
      "why": "Linear unit fixed effects remove additive, time-invariant unit heterogeneity. They do not remove time-varying confounding.",
      "stata": "xtset id time\nxtreg y x1 x2 i.time, fe {vce}",
      "diagnostic": "Check within-unit variation, time effects, strict-exogeneity assumptions and dependence. A nonrejection in a Hausman test does not validate RE.",
      "pitfall": "Treating unit FE as a general identification strategy, or clustering mechanically without considering the assignment and sampling design.",
      "links": [
        {
          "label": "Inspect within-group transformations",
          "href": "../Learn/#group-statistics"
        },
        {
          "label": "Download the panel example",
          "href": "../CodeLibrary/scripts/06_panel_data_toolkit.do"
        },
        {
          "label": "Stata xtreg manual",
          "href": "https://www.stata.com/manuals/xtxtreg.pdf"
        }
      ],
      "category": "Repeated observations",
      "scope": "An alternative linear specification using within-unit changes after removing additive unit and time effects.",
      "assumptions": [
        "Strict exogeneity of the idiosyncratic error with respect to the regressor history is a maintained condition of this static model.",
        "Time-varying confounding, feedback and heterogeneous trends can remain. Time-invariant coefficients are not identified by within-unit changes."
      ]
    },
    "iv": {
      "title": "Linear instrumental variables",
      "why": "A candidate only when relevant excluded instruments and a credible exclusion/exogeneity argument are available.",
      "stata": "ivregress 2sls y x2 (x1 = z1), small {vce}",
      "diagnostic": "Report the first stage and assess weak identification using procedures appropriate to the model and covariance. F > 10 is not a universal guarantee.",
      "pitfall": "Treating a statistical test as proof of instrument validity or claiming finite-sample unbiasedness for 2SLS.",
      "links": [
        {
          "label": "Work through the IV investigations",
          "href": "../Labs/IV/#investigation=iv-stages"
        },
        {
          "label": "Examine weak-instrument confidence sets",
          "href": "../Labs/IV/#investigation=iv-weak"
        }
      ],
      "category": "Proposed research design",
      "scope": "This is a linear IV specification, not an instrumented logit, count or hazard model.",
      "assumptions": [
        "The excluded instrument must supply relevant variation and satisfy a defensible exclusion/exogeneity restriction.",
        "Under heterogeneous effects, define the target and any additional conditions needed for its interpretation."
      ]
    },
    "did": {
      "title": "Two-group, two-period difference-in-differences",
      "why": "A candidate design for treatment and comparison groups observed before and after adoption, under an appropriate parallel-trends assumption.",
      "stata": "regress y i.treated##i.post, {vce}",
      "diagnostic": "Study assignment, anticipation, spillovers and untreated trends. Pre-trend nonrejection cannot establish parallel trends.",
      "pitfall": "Applying the simple two-period specification to staggered adoption with heterogeneous effects without checking the estimand.",
      "links": [
        {
          "label": "Review research-design concepts",
          "href": "../ZeroToHero/modules/00-econometric-mindset.html"
        }
      ],
      "category": "Proposed research design",
      "scope": "A simple comparison of changes in the outcome mean. Binary outcomes are measured in probability points; count outcomes remain in count units.",
      "assumptions": [
        "Parallel untreated mean trends, no anticipation and an appropriate no-interference condition are required for the intended treatment effect.",
        "Treatment timing, composition changes and staggered adoption can require a different estimator or estimand."
      ]
    },
    "diagnostics": {
      "title": "Model-specific diagnostics",
      "why": "Checks can reveal contradictions and misspecification; no checklist certifies identification.",
      "stata": "* OLS illustration: hettest requires conventional VCE.\nregress y x1 x2\nestat hettest\nestat vif\nrvfplot",
      "diagnostic": "Use postestimation commands documented for the fitted estimator. These OLS commands do not apply to every model above.",
      "pitfall": "Using passing tests as proof of exogeneity, normality, valid instruments or the correct functional form.",
      "links": [
        {
          "label": "Diagnostics script",
          "href": "../ScriptLibrary/script.html?id=ols-robust-diagnostics"
        }
      ],
      "category": "Checks",
      "scope": "These commands illustrate OLS postestimation only; they are not an all-model checklist.",
      "assumptions": [
        "A test of a maintained model restriction is not a test of every identifying assumption."
      ]
    },
    "reporting": {
      "title": "Reporting the comparison",
      "why": "Translate estimates into plain-language results and tables.",
      "stata": "estimates table, b(%9.3f) se(%9.3f) stats(N)",
      "diagnostic": "State units, sample restrictions, estimand, uncertainty, identification assumptions and material limitations.",
      "pitfall": "Only reporting p-values without effect size context.",
      "links": [
        {
          "label": "Export tables",
          "href": "../ScriptLibrary/script.html?id=export-regression-table"
        }
      ],
      "category": "Reporting",
      "scope": "State the estimand, units, estimation sample and covariance alongside the coefficient.",
      "assumptions": [
        "Separate what the data show from the assumptions needed to interpret it."
      ]
    },
    "lpm": {
      "title": "Linear probability model",
      "category": "Outcome model",
      "why": "OLS can be used with a binary outcome. Its slopes describe probability-point differences under a linear mean specification, or coefficients of a linear projection.",
      "scope": "A 0/1 outcome does not prohibit OLS. Predictions can leave [0,1], and a linear slope imposes a particular approximation.",
      "assumptions": [
        "Probability-point interpretation concerns a change in a conditional mean or linear projection; it is not automatically a causal effect.",
        "With a nonconstant response probability, binary-outcome errors are generally heteroskedastic."
      ],
      "stata": "regress y x1 x2, {vce}",
      "diagnostic": "Inspect fitted probabilities and whether a constant slope is a useful approximation over the relevant support.",
      "pitfall": "Rejecting every linear model solely because the outcome is binary, or ignoring implausible extrapolation.",
      "links": [
        {
          "label": "Compare binary-outcome models",
          "href": "../ZeroToHero/modules/03-limited-outcomes.html"
        }
      ]
    },
    "panelCount": {
      "title": "Poisson with unit effects",
      "category": "Repeated observations",
      "why": "An exponential mean can include unit effects instead of treating repeated counts as a pooled sample. Conditional fixed-effects Poisson and a Poisson fit with unit indicators provide two implementations.",
      "scope": "Within-unit variation identifies time-varying slopes. A unit-indicator fit may be costly with many units.",
      "assumptions": [
        "The conditional-mean and exogeneity restrictions must hold. Unit effects do not remove time-varying confounding.",
        "Inspect units with no events, exposure and the effective estimation sample."
      ],
      "stata": "xtset id time\n* vce(robust) here allows dependence within each panel.\nxtpoisson y x1 x2 i.time, fe vce(robust)",
      "diagnostic": "Identify dropped units and the variation remaining within units.",
      "pitfall": "Treating a count-model fixed effect or a cluster adjustment as a general remedy for endogeneity.",
      "links": [
        {
          "label": "Stata xtpoisson manual",
          "href": "https://www.stata.com/manuals/xtxtpoisson.pdf"
        }
      ]
    }
  },
  "version": 2
}
